import Submission.Topology.SuperellipsoidTruncatedSphereCircleSection
import Submission.Topology.TwoArcCircle
import Mathlib.GroupTheory.Perm.Cycle.Basic

/-!
# Finite alternating arc cycles from two endpoint pairings

Two perfect pairings of the same finite vertex set form a finite graph of degree two.  This file
constructs its two endpoint involutions, the alternating successor permutation, and the quotient
which indexes its unoriented connected cycles.  No cyclic curves or component enumeration is
included as input.
-/

open Set

noncomputable section

namespace Submission.Topology

universe u v

/-- A finite edge family whose two labelled endpoints enumerate a finite vertex type exactly. -/
structure FiniteEndpointPairing (vertex : Type u) [Fintype vertex] where
  edge : Type v
  finite_edge : Fintype edge
  endpointEquiv : edge × Fin 2 ≃ vertex

namespace FiniteEndpointPairing

variable {vertex : Type*} [Fintype vertex]

/-- Reverse the endpoint label of one edge. -/
def reverseEndpoint {edge : Type*} : Equiv.Perm (edge × Fin 2) :=
  (Equiv.refl edge).prodCongr Fin.revPerm

/-- The fixed-point-free involution exchanging the two endpoints of every edge. -/
def endpointMate (P : FiniteEndpointPairing vertex) : Equiv.Perm vertex :=
  P.endpointEquiv.symm.trans (reverseEndpoint.trans P.endpointEquiv)

@[simp]
theorem endpointMate_apply (P : FiniteEndpointPairing vertex) (v : vertex) :
    P.endpointMate v =
      P.endpointEquiv
        ((P.endpointEquiv.symm v).1, (P.endpointEquiv.symm v).2.rev) := rfl

@[simp]
theorem endpointMate_endpointEquiv (P : FiniteEndpointPairing vertex) (e : P.edge)
    (j : Fin 2) :
    P.endpointMate (P.endpointEquiv (e, j)) = P.endpointEquiv (e, j.rev) := by
  simp [endpointMate_apply]

theorem endpointMate_involutive (P : FiniteEndpointPairing vertex) :
    Function.Involutive P.endpointMate := by
  intro v
  have hv : P.endpointEquiv (P.endpointEquiv.symm v) = v :=
    P.endpointEquiv.apply_symm_apply v
  rw [← hv, endpointMate_endpointEquiv, endpointMate_endpointEquiv, Fin.rev_rev]

@[simp]
theorem endpointMate_endpointMate (P : FiniteEndpointPairing vertex) (v : vertex) :
    P.endpointMate (P.endpointMate v) = v :=
  P.endpointMate_involutive v

theorem endpointMate_ne (P : FiniteEndpointPairing vertex) (v : vertex) :
    P.endpointMate v ≠ v := by
  intro h
  have hp := congrArg P.endpointEquiv.symm h
  simp only [endpointMate, Equiv.trans_apply, Equiv.symm_apply_apply,
    ] at hp
  have he : (P.endpointEquiv.symm v).2.rev =
      (P.endpointEquiv.symm v).2 := congrArg Prod.snd hp
  have hval := congrArg Fin.val he
  have hlt := (P.endpointEquiv.symm v).2.2
  simp [Fin.rev] at hval
  omega

@[simp]
theorem endpointMate_self_comp (P : FiniteEndpointPairing vertex) :
    P.endpointMate * P.endpointMate = 1 := by
  ext v
  exact P.endpointMate_involutive v

end FiniteEndpointPairing

/-- Two edge colours, each of which pairs every vertex exactly once. -/
structure FiniteAlternatingEndpointSystem (vertex : Type u) [Fintype vertex] where
  first : FiniteEndpointPairing.{u, v} vertex
  second : FiniteEndpointPairing.{u, v} vertex

namespace FiniteAlternatingEndpointSystem

variable {vertex : Type*} [Fintype vertex]

/-- Traverse a first-colour edge and then a second-colour edge. -/
def successor (A : FiniteAlternatingEndpointSystem vertex) : Equiv.Perm vertex :=
  A.first.endpointMate.trans A.second.endpointMate

@[simp]
theorem successor_apply (A : FiniteAlternatingEndpointSystem vertex) (v : vertex) :
    A.successor v = A.second.endpointMate (A.first.endpointMate v) := rfl

/-- Adjacency in the underlying unoriented alternating graph. -/
def Incident (A : FiniteAlternatingEndpointSystem vertex) (v w : vertex) : Prop :=
  A.first.endpointMate v = w ∨ A.second.endpointMate v = w

/-- The equivalence relation generated by the two endpoint matchings. -/
def cycleSetoid (A : FiniteAlternatingEndpointSystem vertex) : Setoid vertex :=
  Relation.EqvGen.setoid A.Incident

/-- Canonical finite index type of the unoriented alternating cycles. -/
def CycleIndex (A : FiniteAlternatingEndpointSystem vertex) :=
  Quotient A.cycleSetoid

noncomputable instance cycleIndexFintype (A : FiniteAlternatingEndpointSystem vertex) :
    Fintype A.CycleIndex := by
  change Fintype (Quotient A.cycleSetoid)
  letI : Finite vertex := Finite.of_fintype vertex
  letI : Finite (Quotient A.cycleSetoid) :=
    Finite.of_surjective (Quotient.mk A.cycleSetoid) Quotient.mk_surjective
  exact Fintype.ofFinite _

/-- The cycle containing a vertex. -/
def cycleOfVertex (A : FiniteAlternatingEndpointSystem vertex) (v : vertex) :
    A.CycleIndex := Quotient.mk A.cycleSetoid v

theorem first_mate_same_cycle (A : FiniteAlternatingEndpointSystem vertex) (v : vertex) :
    A.cycleOfVertex (A.first.endpointMate v) = A.cycleOfVertex v := by
  change Quotient.mk A.cycleSetoid (A.first.endpointMate v) =
    Quotient.mk A.cycleSetoid v
  apply Quotient.sound (s := A.cycleSetoid)
  apply Relation.EqvGen.symm
  exact Relation.EqvGen.rel _ _ (Or.inl rfl)

theorem second_mate_same_cycle (A : FiniteAlternatingEndpointSystem vertex) (v : vertex) :
    A.cycleOfVertex (A.second.endpointMate v) = A.cycleOfVertex v := by
  change Quotient.mk A.cycleSetoid (A.second.endpointMate v) =
    Quotient.mk A.cycleSetoid v
  apply Quotient.sound (s := A.cycleSetoid)
  apply Relation.EqvGen.symm
  exact Relation.EqvGen.rel _ _ (Or.inr rfl)

theorem successor_same_cycle (A : FiniteAlternatingEndpointSystem vertex) (v : vertex) :
    A.cycleOfVertex (A.successor v) = A.cycleOfVertex v := by
  rw [successor_apply, A.second_mate_same_cycle, A.first_mate_same_cycle]

/-- Both endpoints of a first-colour edge lie in the same unoriented cycle. -/
theorem first_edge_endpoints_same_cycle (A : FiniteAlternatingEndpointSystem vertex)
    (e : A.first.edge) :
    A.cycleOfVertex (A.first.endpointEquiv (e, (1 : Fin 2))) =
      A.cycleOfVertex (A.first.endpointEquiv (e, (0 : Fin 2))) := by
  have hmate : A.first.endpointMate
      (A.first.endpointEquiv (e, (0 : Fin 2))) =
        A.first.endpointEquiv (e, (1 : Fin 2)) := by
    simp [FiniteEndpointPairing.endpointMate_apply, Fin.rev]
  rw [← hmate]
  exact A.first_mate_same_cycle _

/-- Both endpoints of a second-colour edge lie in the same unoriented cycle. -/
theorem second_edge_endpoints_same_cycle (A : FiniteAlternatingEndpointSystem vertex)
    (e : A.second.edge) :
    A.cycleOfVertex (A.second.endpointEquiv (e, (1 : Fin 2))) =
      A.cycleOfVertex (A.second.endpointEquiv (e, (0 : Fin 2))) := by
  have hmate : A.second.endpointMate
      (A.second.endpointEquiv (e, (0 : Fin 2))) =
        A.second.endpointEquiv (e, (1 : Fin 2)) := by
    simp [FiniteEndpointPairing.endpointMate_apply, Fin.rev]
  rw [← hmate]
  exact A.second_mate_same_cycle _

/-- Every unoriented cycle has a chosen base vertex. -/
noncomputable def baseVertex (A : FiniteAlternatingEndpointSystem vertex)
    (q : A.CycleIndex) : vertex :=
  Classical.choose (Quotient.exists_rep q)

theorem cycleOf_baseVertex (A : FiniteAlternatingEndpointSystem vertex)
    (q : A.CycleIndex) : A.cycleOfVertex (A.baseVertex q) = q := by
  change Quotient.mk A.cycleSetoid (A.baseVertex q) = q
  exact Classical.choose_spec (Quotient.exists_rep q)

/-- Positive return times of the successor at one vertex are nonempty by finiteness. -/
theorem exists_pos_successor_pow_eq (A : FiniteAlternatingEndpointSystem vertex)
    (v : vertex) : ∃ n : ℕ, 0 < n ∧ (A.successor ^ n) v = v := by
  exact ⟨orderOf A.successor, orderOf_pos A.successor, by
    rw [pow_orderOf_eq_one]
    rfl⟩

/-- Length of the oriented successor orbit through a vertex. -/
noncomputable def cycleLengthAt (A : FiniteAlternatingEndpointSystem vertex) (v : vertex) : ℕ :=
  by
    classical
    exact Nat.find (A.exists_pos_successor_pow_eq v)

theorem cycleLengthAt_pos (A : FiniteAlternatingEndpointSystem vertex) (v : vertex) :
    0 < A.cycleLengthAt v :=
  by
    classical
    exact (Nat.find_spec (A.exists_pos_successor_pow_eq v)).1

theorem successor_pow_cycleLengthAt (A : FiniteAlternatingEndpointSystem vertex)
    (v : vertex) :
    (A.successor ^ A.cycleLengthAt v) v = v :=
  by
    classical
    exact (Nat.find_spec (A.exists_pos_successor_pow_eq v)).2

/-- Ordered vertices in one chosen orientation of a finite alternating cycle. -/
def orientedVertex (A : FiniteAlternatingEndpointSystem vertex)
    (q : A.CycleIndex) (i : Fin (A.cycleLengthAt (A.baseVertex q))) : vertex :=
  (A.successor ^ (i : ℕ)) (A.baseVertex q)

/-- Every vertex in the canonical oriented list remains in the selected unoriented cycle. -/
theorem cycleOf_orientedVertex (A : FiniteAlternatingEndpointSystem vertex)
    (q : A.CycleIndex) (i : Fin (A.cycleLengthAt (A.baseVertex q))) :
    A.cycleOfVertex (A.orientedVertex q i) = q := by
  rw [orientedVertex]
  induction i.1 with
  | zero => exact A.cycleOf_baseVertex q
  | succ n ih =>
      rw [pow_succ', Equiv.Perm.mul_apply, A.successor_same_cycle]
      exact ih

/-! ## Exhaustion by the two alternating parities -/

/-- The first endpoint involution carries successor orbits to successor orbits.  Algebraically it
conjugates the successor to its inverse. -/
theorem sameCycle_first_endpointMate (A : FiniteAlternatingEndpointSystem vertex)
    {v w : vertex} (h : A.successor.SameCycle v w) :
    A.successor.SameCycle (A.first.endpointMate v) (A.first.endpointMate w) := by
  let f := A.first.endpointMate
  let g := A.second.endpointMate
  have hfInv : f⁻¹ = f :=
    inv_eq_iff_mul_eq_one.mpr A.first.endpointMate_self_comp
  have hgInv : g⁻¹ = g :=
    inv_eq_iff_mul_eq_one.mpr A.second.endpointMate_self_comp
  have hs : A.successor = g * f := by
    ext x
    rfl
  have hconj : f * A.successor * f⁻¹ = A.successor⁻¹ := by
    rw [hs, hfInv]
    calc
      f * (g * f) * f = f * g * (f * f) := by group
      _ = f * g := by rw [show f * f = 1 from A.first.endpointMate_self_comp, mul_one]
      _ = (g * f)⁻¹ := by rw [mul_inv_rev, hfInv, hgInv]
  have hc : (f * A.successor * f⁻¹).SameCycle (f v) (f w) := by
    exact h.conj
  rw [hconj] at hc
  exact Equiv.Perm.SameCycle.of_inv hc

/-- The second endpoint involution also carries successor orbits to successor orbits. -/
theorem sameCycle_second_endpointMate (A : FiniteAlternatingEndpointSystem vertex)
    {v w : vertex} (h : A.successor.SameCycle v w) :
    A.successor.SameCycle (A.second.endpointMate v) (A.second.endpointMate w) := by
  have hf := A.sameCycle_first_endpointMate h
  have hright : A.successor.SameCycle (A.first.endpointMate v)
      (A.successor (A.first.endpointMate w)) :=
    Equiv.Perm.sameCycle_apply_right.mpr hf
  have hboth : A.successor.SameCycle
      (A.successor (A.first.endpointMate v))
      (A.successor (A.first.endpointMate w)) :=
    Equiv.Perm.sameCycle_apply_left.mpr hright
  simpa only [successor_apply, A.first.endpointMate_endpointMate] using hboth

/-- The equivalence closure of the two edge colours is exactly two successor-orbit parities. -/
theorem eqvGen_incident_twoParity (A : FiniteAlternatingEndpointSystem vertex)
    {v w : vertex} (h : Relation.EqvGen A.Incident v w) :
    A.successor.SameCycle v w ∨
      A.successor.SameCycle (A.first.endpointMate v) w := by
  let R : vertex → vertex → Prop := fun x y ↦
    A.successor.SameCycle x y ∨
      A.successor.SameCycle (A.first.endpointMate x) y
  have hrefl : ∀ x, R x x := fun x ↦ Or.inl (Equiv.Perm.SameCycle.refl _ _)
  have hsymm : ∀ {x y}, R x y → R y x := by
    intro x y hxy
    rcases hxy with hxy | hxy
    · exact Or.inl hxy.symm
    · right
      simpa only [A.first.endpointMate_endpointMate] using
        (A.sameCycle_first_endpointMate hxy).symm
  have htrans : ∀ {x y z}, R x y → R y z → R x z := by
    intro x y z hxy hyz
    rcases hxy with hxy | hxy <;> rcases hyz with hyz | hyz
    · exact Or.inl (hxy.trans hyz)
    · exact Or.inr ((A.sameCycle_first_endpointMate hxy).trans hyz)
    · exact Or.inr (hxy.trans hyz)
    · exact Or.inl (by
        simpa only [A.first.endpointMate_endpointMate] using
          (A.sameCycle_first_endpointMate hxy).trans hyz)
  have hrel : ∀ {x y}, A.Incident x y → R x y := by
    intro x y hxy
    rcases hxy with hfirst | hsecond
    · subst y
      exact Or.inr (Equiv.Perm.SameCycle.refl _ _)
    · subst y
      right
      refine ⟨1, ?_⟩
      simp only [zpow_one, successor_apply, A.first.endpointMate_endpointMate]
  induction h with
  | rel _ _ hxy => exact hrel hxy
  | refl x => exact hrefl x
  | symm _ _ _ ih => exact hsymm ih
  | trans _ _ _ _ _ hxy hyz => exact htrans hxy hyz

/-- Equality with a quotient cycle is equivalent to occurring in the chosen successor list or
in its first-edge mate list.  These are the two parities of an alternating degree-two cycle. -/
theorem cycleOfVertex_eq_iff_twoParity (A : FiniteAlternatingEndpointSystem vertex)
    (q : A.CycleIndex) (v : vertex) :
    A.cycleOfVertex v = q ↔
      (∃ i : Fin (A.cycleLengthAt (A.baseVertex q)),
        v = A.orientedVertex q i) ∨
      (∃ i : Fin (A.cycleLengthAt (A.baseVertex q)),
        v = A.first.endpointMate (A.orientedVertex q i)) := by
  let b := A.baseVertex q
  let L := A.cycleLengthAt b
  have hL : 0 < L := A.cycleLengthAt_pos b
  have hperiod : Function.IsPeriodicPt (A.successor : vertex → vertex) L b := by
    rw [Function.IsPeriodicPt, A.successor.iterate_eq_pow]
    exact A.successor_pow_cycleLengthAt b
  constructor
  · intro hv
    have hquot : A.cycleOfVertex b = A.cycleOfVertex v := by
      rw [A.cycleOf_baseVertex q, hv]
    have heqv : Relation.EqvGen A.Incident b v := by
      apply Quotient.exact (s := A.cycleSetoid)
      change A.cycleOfVertex b = A.cycleOfVertex v
      exact hquot
    rcases A.eqvGen_incident_twoParity heqv with hsame | hsame
    · obtain ⟨n, hn⟩ := hsame.exists_nat_pow_eq
      let i : Fin L := ⟨n % L, Nat.mod_lt n hL⟩
      left
      refine ⟨i, ?_⟩
      rw [orientedVertex]
      change v = (A.successor ^ (n % L)) b
      have hmod := hperiod.iterate_mod_apply n
      rw [A.successor.iterate_eq_pow, A.successor.iterate_eq_pow] at hmod
      rw [hmod]
      exact hn.symm
    · have hmate := A.sameCycle_first_endpointMate hsame
      obtain ⟨n, hn⟩ := hmate.exists_nat_pow_eq
      let i : Fin L := ⟨n % L, Nat.mod_lt n hL⟩
      right
      refine ⟨i, ?_⟩
      rw [orientedVertex]
      have hmod : (A.successor ^ (n % L)) b = A.first.endpointMate v := by
        have hperiodMod := hperiod.iterate_mod_apply n
        rw [A.successor.iterate_eq_pow, A.successor.iterate_eq_pow] at hperiodMod
        rw [hperiodMod]
        simpa only [A.first.endpointMate_endpointMate] using hn
      have hmate := congrArg A.first.endpointMate hmod
      simpa only [A.first.endpointMate_endpointMate] using hmate.symm
  · rintro (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact A.cycleOf_orientedVertex q i
    · rw [A.first_mate_same_cycle, A.cycleOf_orientedVertex]

/-! ## Canonical finite concatenation of oriented alternating arcs -/

variable {X : Type*} [TopologicalSpace X]

/-- Geometric paths for the unoriented edges of one endpoint pairing. -/
structure EndpointPathFamily (P : FiniteEndpointPairing vertex) (point : vertex → X) where
  path : ∀ e, Path (point (P.endpointEquiv (e, 0))) (point (P.endpointEquiv (e, 1)))

namespace EndpointPathFamily

variable {P : FiniteEndpointPairing vertex} {point : vertex → X}
  (D : EndpointPathFamily P point)

private noncomputable def orientedPathAt (e : P.edge) :
    ∀ j : Fin 2,
      Path (point (P.endpointEquiv (e, j)))
        (point (P.endpointEquiv (e, j.rev))) :=
  Fin.cases (by simpa [Fin.rev] using D.path e)
    (fun j : Fin 1 ↦
      Fin.cases (by simpa [Fin.rev] using (D.path e).symm)
        (fun j : Fin 0 ↦ Fin.elim0 j) j)

/-- Orient the unique edge of the pairing away from a specified endpoint. -/
noncomputable def orientedPath (v : vertex) :
    Path (point v) (point (P.endpointMate v)) := by
  rcases hp : P.endpointEquiv.symm v with ⟨e, j⟩
  have hv : P.endpointEquiv (e, j) = v := by
    rw [← hp, P.endpointEquiv.apply_symm_apply]
  exact (D.orientedPathAt e j).cast (congrArg point hv.symm) (congrArg point (by
    rw [← hv, P.endpointMate_endpointEquiv]))

end EndpointPathFamily

/-- Oriented geometric arcs for the two colours.  The second arc is indexed after traversing the
first mate, so one `stepPath` follows exactly one application of `successor`. -/
structure OrientedAlternatingArcFamily (A : FiniteAlternatingEndpointSystem vertex)
    (point : vertex → X) where
  first : ∀ v, Path (point v) (point (A.first.endpointMate v))
  second : ∀ v, Path (point (A.first.endpointMate v)) (point (A.successor v))

/-- Orient two ordinary endpoint-indexed path families compatibly with the alternating successor. -/
noncomputable def OrientedAlternatingArcFamily.ofEndpointPathFamilies
    {A : FiniteAlternatingEndpointSystem vertex} {point : vertex → X}
    (first : EndpointPathFamily A.first point)
    (second : EndpointPathFamily A.second point) :
    OrientedAlternatingArcFamily A point where
  first := first.orientedPath
  second v := second.orientedPath (A.first.endpointMate v) |>.cast rfl
    (congrArg point (by rw [successor_apply]))

namespace OrientedAlternatingArcFamily

variable {A : FiniteAlternatingEndpointSystem vertex} {point : vertex → X}

/-- One first-colour arc followed by one second-colour arc. -/
def stepPath (D : OrientedAlternatingArcFamily A point) (v : vertex) :
    Path (point v) (point (A.successor v)) :=
  (D.first v).trans (D.second v)

/-- Concatenate the first `n` alternating steps of the successor orbit. -/
def successorPowPath (D : OrientedAlternatingArcFamily A point) (v : vertex) : ∀ n : ℕ,
    Path (point v) (point ((A.successor ^ n) v))
  | 0 => Path.refl (point v)
  | n + 1 =>
      ((successorPowPath D v n).trans (D.stepPath ((A.successor ^ n) v))).cast
        rfl (congrArg point (by rw [pow_succ', Equiv.Perm.mul_apply]))

/-- Concatenate a nonempty sequence of successor steps.  The parameter `n` records the number
of steps after the first one, so this construction never inserts a constant reflexive half-path. -/
def successorStepsNE (D : OrientedAlternatingArcFamily A point) (v : vertex) : ∀ n : ℕ,
    Path (point v) (point ((A.successor ^ (n + 1)) v))
  | 0 => (D.stepPath v).cast rfl (congrArg point (by simp))
  | n + 1 =>
      ((successorStepsNE D v n).trans
        (D.stepPath ((A.successor ^ (n + 1)) v))).cast
          rfl (congrArg point (by rw [pow_succ', Equiv.Perm.mul_apply]))

/-- The complementary arc starts with the second-colour edge at the base vertex and then follows
all remaining alternating steps. -/
def complementPath (D : OrientedAlternatingArcFamily A point) (q : A.CycleIndex) :
    Path (point (A.first.endpointMate (A.baseVertex q)))
      (point (A.baseVertex q)) := by
  let b := A.baseVertex q
  let L := A.cycleLengthAt b
  by_cases hL : L = 1
  · have hsuccessor : A.successor b = b := by
      have hreturn := A.successor_pow_cycleLengthAt b
      simpa only [L, hL, pow_one] using hreturn
    exact (D.second b).cast rfl (congrArg point hsuccessor.symm)
  · have htwo : 2 ≤ L := by
      have hpos : 0 < L := A.cycleLengthAt_pos b
      omega
    let tail := (D.second b).trans
      (successorStepsNE D (A.successor b) (L - 2))
    have hcount : (L - 2) + 1 + 1 = L := by omega
    have hpow : (A.successor ^ ((L - 2) + 1)) (A.successor b) =
        (A.successor ^ L) b := by
      rw [← Equiv.Perm.mul_apply, ← pow_succ, hcount]
    exact tail.cast rfl (congrArg point
      (hpow.trans (A.successor_pow_cycleLengthAt b)).symm)

/-- The two canonical opposite paths which will be glued by `TwoArcCircle`. -/
def firstPath (D : OrientedAlternatingArcFamily A point) (q : A.CycleIndex) :
    Path (point (A.baseVertex q))
      (point (A.first.endpointMate (A.baseVertex q))) :=
  D.first (A.baseVertex q)

/-- Global embeddedness hypotheses for the two canonical concatenated paths.  These are purely
set-theoretic consequences of embedded constituent arcs and endpoint-only cross-colour incidence;
the ambient local germ is intentionally not part of this datum. -/
structure TwoArcData (D : OrientedAlternatingArcFamily A point)
    (q : A.CycleIndex) : Prop where
  data : TwoArcCircle.Data (D.firstPath q) (D.complementPath q)

/-- The canonical circle obtained from one finite alternating successor cycle. -/
def circleMap (D : OrientedAlternatingArcFamily A point)
    (q : A.CycleIndex) (z : Circle) : X :=
  TwoArcCircle.circleMap (D.firstPath q) (D.complementPath q) z

theorem continuous_circleMap (D : OrientedAlternatingArcFamily A point)
    (q : A.CycleIndex) : Continuous (D.circleMap q) :=
  TwoArcCircle.continuous_circleMap _ _

theorem circleMap_injective (D : OrientedAlternatingArcFamily A point)
    (q : A.CycleIndex) (H : D.TwoArcData q) :
    Function.Injective (D.circleMap q) := H.data.injective

theorem range_circleMap (D : OrientedAlternatingArcFamily A point)
    (q : A.CycleIndex) :
    Set.range (D.circleMap q) =
      Set.range (D.firstPath q) ∪ Set.range (D.complementPath q) :=
  TwoArcCircle.range_circleMap _ _

end OrientedAlternatingArcFamily

end FiniteAlternatingEndpointSystem

end Submission.Topology
