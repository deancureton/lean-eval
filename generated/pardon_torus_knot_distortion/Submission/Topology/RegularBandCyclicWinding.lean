import Submission.Topology.BasedLoopCarrier
import Submission.Topology.InessentialSliceCircle
import Submission.Topology.LoopHalfspaceCut
import Submission.Topology.OrientedCoordinateRegularBand

/-!
# Cyclic winding in a regular transported-torus band

A compact band without critical heights should be a finite union of annuli.  The normalized
gradient field `grad h / ‖grad h‖²` has height derivative one, so its complete flow identifies each
connected band component with one regular circle fiber times the height interval.  Contracting
the interval factor gives a deformation onto that circle.

This file isolates precisely that product-annulus output and proves its winding consequence.  It
does not assume that a component is noncarrying.  Instead, periodic-homotopy invariance reduces
every loop to the core circle, and an explicit composition of covering lifts proves that its
winding vector is an integral multiple of the core winding vector.

The remaining analytic construction is `RegularBandComponentCyclicRetractionData`: build its
deformation from the normalized-gradient flow, using compactness of the closed band for uniform
existence up to both boundary heights.
-/

open LeanEval.KnotTheory.PardonDistortion
open Set Topology

noncomputable section

namespace Submission.Topology

open Submission.PardonDistortion
open Submission.SurfaceRegularValue
open Submission.Torus

/-! ## Winding of a loop factored through an embedded torus circle -/

/-- Iterating the affine period law through an arbitrary integral number of periods. -/
theorem circleLoopLift_angle_add_int_mul_period {gamma : ℝ → Circle}
    (L : CircleLoopLift gamma) (k : ℤ) (t : ℝ) :
    L.angle (t + (k : ℝ) * (2 * Real.pi)) =
      L.angle t + ((k * L.winding : ℤ) : ℝ) * (2 * Real.pi) := by
  have herror := L.error_periodic.int_mul k t
  unfold CircleLoopLift.error at herror
  rw [Int.cast_mul]
  linear_combination herror

namespace EmbeddedTorusIntersectionCircle

variable {Phi : AmbientIsotopy} {s : Set (transportedTorus Phi)}

/-- Compose the two covering angles of an embedded torus circle with a covering angle for a
contained loop's circle parameter.  The resulting winding coordinates are the factor degree
times the two winding coordinates of the embedded circle. -/
def windingLiftOfContainedLoop (C : EmbeddedTorusIntersectionCircle Phi)
    (L : TransportedWindingLoop Phi s)
    (hsub : Set.range (fun t ↦ (L.curve t : R3)) ⊆ Set.range C.circle) :
    TorusLoopLift (transportedLoopCoordinates Phi L.curve) := by
  let A := C.factorCurveLift L hsub
  exact {
    first := {
      angle := fun t ↦ C.windingLoop.lift.first.angle (A.angle t)
      continuous_angle := C.windingLoop.lift.first.continuous_angle.comp A.continuous_angle
      exp_angle := fun t ↦ by
        rw [C.windingLoop.lift.first.exp_angle]
        exact congrArg Prod.fst
          (C.transportedLoopCoordinates_eq_at_factorCurveLift L hsub t).symm
      winding := A.winding * C.windingLoop.lift.first.winding
      angle_add_period := fun t ↦ by
        rw [A.angle_add_period]
        exact circleLoopLift_angle_add_int_mul_period
          C.windingLoop.lift.first A.winding (A.angle t)
    }
    second := {
      angle := fun t ↦ C.windingLoop.lift.second.angle (A.angle t)
      continuous_angle := C.windingLoop.lift.second.continuous_angle.comp A.continuous_angle
      exp_angle := fun t ↦ by
        rw [C.windingLoop.lift.second.exp_angle]
        exact congrArg Prod.snd
          (C.transportedLoopCoordinates_eq_at_factorCurveLift L hsub t).symm
      winding := A.winding * C.windingLoop.lift.second.winding
      angle_add_period := fun t ↦ by
        rw [A.angle_add_period]
        exact circleLoopLift_angle_add_int_mul_period
          C.windingLoop.lift.second A.winding (A.angle t)
    }
  }

/-- Every loop contained in an embedded torus circle has winding vector in the cyclic subgroup
generated by that circle's winding vector. -/
theorem exists_windingPair_eq_mul_of_range_subset
    (C : EmbeddedTorusIntersectionCircle Phi)
    (L : TransportedWindingLoop Phi s)
    (hsub : Set.range (fun t ↦ (L.curve t : R3)) ⊆ Set.range C.circle) :
    ∃ k : ℤ, L.windingPair =
      (k * C.windingLoop.windingPair.1, k * C.windingLoop.windingPair.2) := by
  let A := C.factorCurveLift L hsub
  refine ⟨A.winding, ?_⟩
  have heq := L.lift.windingPair_eq (C.windingLiftOfContainedLoop L hsub)
  change L.lift.windingPair =
    (A.winding * C.windingLoop.lift.first.winding,
      A.winding * C.windingLoop.lift.second.winding)
  exact heq

end EmbeddedTorusIntersectionCircle

/-! ## The transported closed band and one connected component -/

namespace OrientedCoordinateRegularBandData

variable {Phi : AmbientIsotopy} {frame : Equiv.Perm (Fin 3)} {d : ℝ}

/-- The closed regular band transported from product-circle coordinates to the embedded torus. -/
def transportedClosedBand
    (B : OrientedCoordinateRegularBandData Phi frame d) :
    Set (transportedTorus Phi) :=
  (transportedTorusHomeomorph Phi).symm ⁻¹'
    coordinateTorusClosedRegularBand Phi frame d B.ε

theorem isClosed_transportedClosedBand
    (B : OrientedCoordinateRegularBandData Phi frame d) :
    IsClosed B.transportedClosedBand :=
  (isClosed_coordinateTorusClosedRegularBand Phi frame d B.ε).preimage
    (transportedTorusHomeomorph Phi).symm.continuous

theorem isCompact_transportedClosedBand
    (B : OrientedCoordinateRegularBandData Phi frame d) :
    IsCompact B.transportedClosedBand :=
  (transportedTorusHomeomorph Phi).symm.isCompact_preimage.mpr
    (isCompact_coordinateTorusClosedRegularBand Phi frame d B.ε)

/-- The connected component of the closed regular band containing a specified point. -/
def closedBandComponent
    (B : OrientedCoordinateRegularBandData Phi frame d)
    (x : transportedTorus Phi) : Set (transportedTorus Phi) :=
  connectedComponentIn B.transportedClosedBand x

theorem closedBandComponent_subset
    (B : OrientedCoordinateRegularBandData Phi frame d)
    (x : transportedTorus Phi) :
    B.closedBandComponent x ⊆ B.transportedClosedBand :=
  connectedComponentIn_subset _ _

end OrientedCoordinateRegularBandData

/-! ## Product-annulus output and its cyclic winding consequence -/

/-- Exact output needed from a normalized-gradient product-annulus construction on one band
component.

The deformation is ambiently defined on the transported torus to make periodic-loop homotopies
direct.  Only its behavior on the selected component is constrained: it stays in the component,
starts at the identity, and ends on one embedded regular-fiber circle. -/
structure RegularBandComponentCyclicRetractionData
    {Phi : AmbientIsotopy} {frame : Equiv.Perm (Fin 3)} {d : ℝ}
    (B : OrientedCoordinateRegularBandData Phi frame d)
    (base : transportedTorus Phi) where
  base_mem : base ∈ B.transportedClosedBand
  core : EmbeddedTorusIntersectionCircle Phi
  core_mem_component : ∀ t, core.windingLoop.curve t ∈ B.closedBandComponent base
  deformation : ℝ → transportedTorus Phi → transportedTorus Phi
  continuous_deformation : Continuous (Function.uncurry deformation)
  deformation_mem_component : ∀ u x,
    x ∈ B.closedBandComponent base →
      deformation u x ∈ B.closedBandComponent base
  deformation_zero : ∀ x, x ∈ B.closedBandComponent base → deformation 0 x = x
  deformation_one_mem_core : ∀ x, x ∈ B.closedBandComponent base →
    (deformation 1 x : R3) ∈ Set.range core.circle

namespace RegularBandComponentCyclicRetractionData

variable {Phi : AmbientIsotopy} {frame : Equiv.Perm (Fin 3)} {d : ℝ}
  {B : OrientedCoordinateRegularBandData Phi frame d}
  {base : transportedTorus Phi}

/-- Endpoint of the component deformation applied to a periodic loop. -/
def endpointCurve
    (D : RegularBandComponentCyclicRetractionData B base)
    {s : Set (transportedTorus Phi)} (L : TransportedWindingLoop Phi s)
    (_hcomponent : ∀ t, L.curve t ∈ B.closedBandComponent base) :
    ℝ → transportedTorus Phi :=
  fun t ↦ D.deformation 1 (L.curve t)

theorem continuous_endpointCurve
    (D : RegularBandComponentCyclicRetractionData B base)
    {s : Set (transportedTorus Phi)} (L : TransportedWindingLoop Phi s)
    (hcomponent : ∀ t, L.curve t ∈ B.closedBandComponent base) :
    Continuous (D.endpointCurve L hcomponent) :=
  D.continuous_deformation.comp (continuous_const.prodMk L.continuous_curve)

theorem periodic_endpointCurve
    (D : RegularBandComponentCyclicRetractionData B base)
    {s : Set (transportedTorus Phi)} (L : TransportedWindingLoop Phi s)
    (hcomponent : ∀ t, L.curve t ∈ B.closedBandComponent base) :
    Function.Periodic (D.endpointCurve L hcomponent) (2 * Real.pi) := by
  intro t
  unfold endpointCurve
  rw [L.periodic_curve]

/-- The deformation endpoint bundled as a winding loop in the same component. -/
def endpointLoop
    (D : RegularBandComponentCyclicRetractionData B base)
    (L : TransportedWindingLoop Phi (B.closedBandComponent base)) :
    TransportedWindingLoop Phi (B.closedBandComponent base) where
  curve := D.endpointCurve L L.curve_mem
  continuous_curve := D.continuous_endpointCurve L L.curve_mem
  periodic_curve := D.periodic_endpointCurve L L.curve_mem
  curve_mem := fun t ↦ D.deformation_mem_component 1 (L.curve t) (L.curve_mem t)
  lift := Classical.choice <| exists_torusLoopLift_of_transportedLoop Phi _
    (D.continuous_endpointCurve L L.curve_mem)
    (D.periodic_endpointCurve L L.curve_mem)

/-- Product-circle coordinates of the component deformation give a periodic loop homotopy. -/
def periodicHomotopyToEndpoint
    (D : RegularBandComponentCyclicRetractionData B base)
    (L : TransportedWindingLoop Phi (B.closedBandComponent base)) :
    PeriodicTorusLoopHomotopy
      (transportedLoopCoordinates Phi L.curve)
      (transportedLoopCoordinates Phi (D.endpointLoop L).curve) where
  homotopy := fun u t ↦
    (transportedTorusHomeomorph Phi).symm (D.deformation u (L.curve t))
  continuous_homotopy :=
    (transportedTorusHomeomorph Phi).symm.continuous.comp <|
      D.continuous_deformation.comp
        (continuous_fst.prodMk (L.continuous_curve.comp continuous_snd))
  periodic_homotopy := by
    intro u t
    exact congrArg (fun x ↦
      (transportedTorusHomeomorph Phi).symm (D.deformation u x))
      (L.periodic_curve t)
  homotopy_zero := by
    funext t
    rw [D.deformation_zero (L.curve t) (L.curve_mem t)]
    rfl
  homotopy_one := rfl

/-- Every loop in a retracting regular-band component has winding vector in the cyclic subgroup
generated by the regular core fiber. -/
theorem exists_windingPair_eq_mul
    (D : RegularBandComponentCyclicRetractionData B base)
    (L : TransportedWindingLoop Phi (B.closedBandComponent base)) :
    ∃ k : ℤ, L.windingPair =
      (k * D.core.windingLoop.windingPair.1,
        k * D.core.windingLoop.windingPair.2) := by
  let endpoint := D.endpointLoop L
  have hhomotopy := TorusLoopLift.windingPair_eq_of_periodicHomotopy
    (D.periodicHomotopyToEndpoint L) L.lift endpoint.lift
  have hsubset : Set.range (fun t ↦ (endpoint.curve t : R3)) ⊆
      Set.range D.core.circle := by
    rintro _ ⟨t, rfl⟩
    exact D.deformation_one_mem_core (L.curve t) (L.curve_mem t)
  obtain ⟨k, hk⟩ := D.core.exists_windingPair_eq_mul_of_range_subset endpoint hsubset
  exact ⟨k, hhomotopy.trans hk⟩

/-- Cyclic winding image rules out two independent winding classes in the component. -/
theorem not_carriesLoopTorusGenus
    (D : RegularBandComponentCyclicRetractionData B base) :
    ¬ CarriesLoopTorusGenus Phi (B.closedBandComponent base) := by
  rintro ⟨W⟩
  obtain ⟨k, hk⟩ := D.exists_windingPair_eq_mul W.first
  obtain ⟨l, hl⟩ := D.exists_windingPair_eq_mul W.second
  apply W.independent
  rw [hk, hl]
  simp only [windingDet]
  ring

/-- In particular, a retracting regular-band component cannot carry a based rank-two pair. -/
theorem not_carriesBasedLoopTorusGenus
    (D : RegularBandComponentCyclicRetractionData B base) :
    ¬ CarriesBasedLoopTorusGenus Phi (B.closedBandComponent base) :=
  fun h ↦ D.not_carriesLoopTorusGenus h.toCarriesLoopTorusGenus

end RegularBandComponentCyclicRetractionData

/-- Global product-annulus output: every nonempty connected component of the compact regular band
has the explicit cyclic deformation above.  This is the exact target for the complete
normalized-gradient flow construction. -/
structure OrientedCoordinateRegularBandCyclicRetractionData
    {Phi : AmbientIsotopy} {frame : Equiv.Perm (Fin 3)} {d : ℝ}
    (B : OrientedCoordinateRegularBandData Phi frame d) where
  componentRetraction : ∀ base, base ∈ B.transportedClosedBand →
    Nonempty (RegularBandComponentCyclicRetractionData B base)

namespace OrientedCoordinateRegularBandCyclicRetractionData

variable {Phi : AmbientIsotopy} {frame : Equiv.Perm (Fin 3)} {d : ℝ}
  {B : OrientedCoordinateRegularBandData Phi frame d}

/-- Every connected component of a regular band with product-annulus data has cyclic winding
image and therefore cannot carry based torus genus. -/
theorem component_not_carriesBasedLoopTorusGenus
    (G : OrientedCoordinateRegularBandCyclicRetractionData B)
    (base : transportedTorus Phi) (hbase : base ∈ B.transportedClosedBand) :
    ¬ CarriesBasedLoopTorusGenus Phi (B.closedBandComponent base) := by
  obtain ⟨D⟩ := G.componentRetraction base hbase
  exact D.not_carriesBasedLoopTorusGenus

end OrientedCoordinateRegularBandCyclicRetractionData

end Submission.Topology
