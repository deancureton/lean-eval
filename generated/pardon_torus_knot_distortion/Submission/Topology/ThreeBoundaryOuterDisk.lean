import Submission.Topology.MaximalInessentialDiskFamilyExistence

/-!
# The outer disk of a three-boundary planar carrier

Let `Q` be a connected pair-of-pants subsurface of the transported torus whose three boundary
circles have zero winding.  The canonical Schoenflies disks bounded by the circles are laminar.
Consequently, either one disk contains `Q`, or all three disks are pairwise disjoint and `Q` is
on the exterior side of each disk.

The last alternative is ruled out by two genuinely global facts about an embedded pair of pants:

* the complement of the three exterior disks is contained in `Q`; and
* every loop in `Q` has winding generated by the three boundary loops.

The second fact forces every loop in `Q` to have zero winding.  The finite radial pushout, on the
other hand, constructs two independent based loops in the complement of three pairwise-disjoint
canonical disks.  This contradiction identifies an outer boundary disk containing `Q`.

The present module proves all finite, laminar, and carrier consequences.  The two global facts
are isolated in `ThreeBoundaryPairOfPantsTopology`; deriving them from a homeomorphism with a
standard pair of pants is the remaining surface-topology input.
-/

open LeanEval.KnotTheory.PardonDistortion
open Set Topology

noncomputable section

namespace Submission.Topology

open Submission.PardonDistortion Submission.Torus

variable {Phi : AmbientIsotopy}

namespace EmbeddedTorusIntersectionCircle

/-- An embedded intersection circle with its transported-torus membership bundled. -/
def torusCircle (C : EmbeddedTorusIntersectionCircle Phi) (z : Circle) :
    transportedTorus Phi :=
  ⟨C.circle z, C.range_subset_transportedTorus ⟨z, rfl⟩⟩

@[simp] theorem coe_torusCircle
    (C : EmbeddedTorusIntersectionCircle Phi) (z : Circle) :
    (C.torusCircle z : R3) = C.circle z :=
  rfl

end EmbeddedTorusIntersectionCircle

/-- Three disjoint zero-winding circles forming the exact boundary of a connected carrier.

The `interior` fields record the codimension-zero pair-of-pants trace without pretending that
connectedness and boundary exactness alone imply the global pair-of-pants classification. -/
structure ThreeBoundaryPairOfPantsCarrier (Phi : AmbientIsotopy) where
  carrier : Set (transportedTorus Phi)
  interior : Set (transportedTorus Phi)
  circle : Fin 3 → EmbeddedTorusIntersectionCircle Phi
  zeroWinding : ∀ i, (circle i).windingLoop.windingPair = (0, 0)
  pairwise_disjoint : Pairwise fun i j ↦
    Disjoint (Set.range (circle i).circle) (Set.range (circle j).circle)
  interior_nonempty : interior.Nonempty
  interior_isConnected : IsConnected interior
  interior_isOpen : IsOpen interior
  interior_subset_carrier : interior ⊆ carrier
  carrier_subset_closure_interior : carrier ⊆ closure interior
  boundary_exact : carrier \ interior = ⋃ i, Set.range (circle i).torusCircle

namespace ThreeBoundaryPairOfPantsCarrier

variable (Q : ThreeBoundaryPairOfPantsCarrier Phi)

/-- The `i`th boundary carrier. -/
def boundary (i : Fin 3) : Set (transportedTorus Phi) :=
  Set.range (Q.circle i).torusCircle

/-- The canonical projected Schoenflies disk bounded by the `i`th circle. -/
def disk (i : Fin 3) : Set (transportedTorus Phi) :=
  (Q.circle i).zeroWindingProjectedClosedJordanDisk (Q.zeroWinding i)

/-- The simultaneous complement of the three canonical disks. -/
def diskComplement : Set (transportedTorus Phi) :=
  EmbeddedTorusIntersectionCircle.finiteZeroWindingDiskComplement Q.circle Q.zeroWinding

theorem boundary_nonempty (i : Fin 3) : (Q.boundary i).Nonempty :=
  Set.range_nonempty _

/-- Every named boundary is contained in the exact boundary of the carrier. -/
theorem boundary_subset_carrier (i : Fin 3) : Q.boundary i ⊆ Q.carrier := by
  intro x hx
  have hxBoundary : x ∈ Q.carrier \ Q.interior := by
    rw [Q.boundary_exact]
    exact Set.mem_iUnion.mpr ⟨i, hx⟩
  exact hxBoundary.1

/-- The real-periodic and circle-parametrized versions of a boundary have the same range. -/
theorem range_circle_eq_range_windingCurve (i : Fin 3) :
    Set.range (Q.circle i).torusCircle =
      Set.range (Q.circle i).windingLoop.curve := by
  apply Set.Subset.antisymm
  · rintro _ ⟨z, rfl⟩
    obtain ⟨t, rfl⟩ := Circle.exp_surjective z
    refine ⟨t, Subtype.ext ?_⟩
    exact ((Q.circle i).parametrization t).symm
  · rintro _ ⟨t, rfl⟩
    refine ⟨Circle.exp t, Subtype.ext ?_⟩
    exact (Q.circle i).parametrization t

/-- Ambient disjointness of the embedded circles descends to their subtype-valued carriers. -/
theorem boundaries_disjoint {i j : Fin 3} (hij : i ≠ j) :
    Disjoint (Q.boundary i) (Q.boundary j) := by
  rw [Set.disjoint_left]
  rintro x ⟨z, hz⟩ ⟨w, hw⟩
  apply Set.disjoint_left.mp (Q.pairwise_disjoint hij)
  · exact ⟨z, congrArg Subtype.val hz⟩
  · exact ⟨w, congrArg Subtype.val hw⟩

/-- A boundary circle lies in its canonical projected disk. -/
theorem boundary_subset_disk (i : Fin 3) : Q.boundary i ⊆ Q.disk i := by
  rw [boundary, Q.range_circle_eq_range_windingCurve i]
  rintro _ ⟨t, rfl⟩
  rw [disk, (Q.circle i).zeroWindingProjectedClosedJordanDisk_eq_range]
  refine ⟨unitDiskBoundary t, ?_⟩
  apply Subtype.ext
  change EmbeddedTorusIntersectionCircle.torusCoveringProjection Phi
      ((Q.circle i).zeroWindingPlaneDisk (Q.zeroWinding i) (unitDiskBoundary t)) =
    ((Q.circle i).windingLoop.curve t : R3)
  rw [(Q.circle i).zeroWindingPlaneDisk_boundary]
  change transportedTorusMap Phi
      (Circle.exp ((Q.circle i).windingLoop.lift.first.angle t),
        Circle.exp ((Q.circle i).windingLoop.lift.second.angle t)) = _
  rw [(Q.circle i).windingLoop.lift.first.exp_angle,
    (Q.circle i).windingLoop.lift.second.exp_angle]
  change ((transportedTorusHomeomorph Phi)
    (transportedLoopCoordinates Phi (Q.circle i).windingLoop.curve t) : R3) = _
  exact congrArg Subtype.val <|
    (transportedTorusHomeomorph Phi).apply_symm_apply ((Q.circle i).windingLoop.curve t)

/-- A canonical projected disk is closed in the transported torus. -/
theorem isClosed_disk (i : Fin 3) : IsClosed (Q.disk i) :=
  (Q.circle i).isClosed_zeroWindingProjectedClosedJordanDisk (Q.zeroWinding i)

/-- Existing planar Schoenflies nesting descends to the three canonical torus disks. -/
theorem disks_disjoint_or_nested {i j : Fin 3} (hij : i ≠ j) :
    Disjoint (Q.disk i) (Q.disk j) ∨
      Q.disk i ⊆ Q.disk j ∨ Q.disk j ⊆ Q.disk i :=
  (Q.circle i).disjoint_or_nested_zeroWindingProjectedClosedJordanDisks
    (Q.circle j) (Q.zeroWinding i) (Q.zeroWinding j) (Q.pairwise_disjoint hij)

/-- The precise Jordan-side input needed below.

For a genuine codimension-zero pair of pants, connectedness of its interior and separation by
the `i`th boundary imply this alternative.  The current torus-disk API does not yet expose the
open interior/frontier theorem needed to derive it from the preceding structure fields. -/
def HasCanonicalDiskSides : Prop :=
  ∀ i, Q.carrier ⊆ Q.disk i ∨
    Disjoint Q.carrier (Q.disk i \ Q.boundary i)

/-- A slightly more local side contract: on the disk side it only places the dense interior of
the pair of pants in the disk.  Closedness of the canonical disk upgrades this to containment of
the whole carrier. -/
def HasCanonicalInteriorDiskSides : Prop :=
  ∀ i, Q.interior ⊆ Q.disk i ∨
    Disjoint Q.carrier (Q.disk i \ Q.boundary i)

/-- Density of the pair-of-pants interior and closedness of the canonical disks upgrade the
interior-side alternative to the closed-carrier alternative. -/
theorem hasCanonicalDiskSides_of_interiorDiskSides
    (hsides : Q.HasCanonicalInteriorDiskSides) :
    Q.HasCanonicalDiskSides := by
  intro i
  rcases hsides i with hinterior | hexterior
  · left
    intro x hx
    have hxClosure : x ∈ closure Q.interior := Q.carrier_subset_closure_interior hx
    have hxDiskClosure : x ∈ closure (Q.disk i) := closure_mono hinterior hxClosure
    rwa [(Q.isClosed_disk i).closure_eq] at hxDiskClosure
  · exact Or.inr hexterior

/-- If the carrier is exterior to every canonical disk, nesting is impossible. -/
theorem disks_pairwise_disjoint_of_all_exterior
    (hexterior : ∀ i, Disjoint Q.carrier (Q.disk i \ Q.boundary i)) :
    Pairwise fun i j ↦ Disjoint (Q.disk i) (Q.disk j) := by
  intro i j hij
  rcases Q.disks_disjoint_or_nested hij with hdisjoint | hijNested | hjiNested
  · exact hdisjoint
  · exfalso
    obtain ⟨x, hxBoundary⟩ := Q.boundary_nonempty i
    have hxNotBoundary : x ∉ Q.boundary j := by
      intro hxj
      exact Set.disjoint_left.mp (Q.boundaries_disjoint hij) hxBoundary hxj
    exact Set.disjoint_left.mp (hexterior j)
      (Q.boundary_subset_carrier i hxBoundary)
      ⟨hijNested (Q.boundary_subset_disk i hxBoundary), hxNotBoundary⟩
  · exfalso
    obtain ⟨x, hxBoundary⟩ := Q.boundary_nonempty j
    have hxNotBoundary : x ∉ Q.boundary i := by
      intro hxi
      exact Set.disjoint_left.mp (Q.boundaries_disjoint hij) hxi hxBoundary
    exact Set.disjoint_left.mp (hexterior i)
      (Q.boundary_subset_carrier j hxBoundary)
      ⟨hjiNested (Q.boundary_subset_disk j hxBoundary), hxNotBoundary⟩

/-- Strongest disk conclusion requiring only the local side alternative and disk laminarity. -/
theorem exists_disk_contains_or_pairwise_disjoint_exterior
    (hsides : Q.HasCanonicalDiskSides) :
    (∃ i, Q.carrier ⊆ Q.disk i) ∨
      (Pairwise fun i j ↦ Disjoint (Q.disk i) (Q.disk j)) ∧
        ∀ i, Disjoint Q.carrier (Q.disk i \ Q.boundary i) := by
  by_cases hcontains : ∃ i, Q.carrier ⊆ Q.disk i
  · exact Or.inl hcontains
  · right
    have hexterior : ∀ i, Disjoint Q.carrier (Q.disk i \ Q.boundary i) := by
      intro i
      exact (hsides i).resolve_left (not_exists.mp hcontains i)
    exact ⟨Q.disks_pairwise_disjoint_of_all_exterior hexterior, hexterior⟩

end ThreeBoundaryPairOfPantsCarrier

/-! ## The genuine pair-of-pants topology input -/

/-- Global topology of an embedded pair of pants, stated in the exact form used by the carrier
argument.

`exterior_complement_subset` is the codimension-zero complement theorem: when the trace is on
the exterior side of all three boundary disks, deleting those disks leaves only the trace.
`winding_generated_by_boundary` is the abelianized fundamental-group theorem for a pair of
pants.  It is deliberately expressed as generation by boundary classes rather than as the
desired outer-disk conclusion. -/
structure ThreeBoundaryPairOfPantsTopology
    (Q : ThreeBoundaryPairOfPantsCarrier Phi) where
  canonicalInteriorDiskSides : Q.HasCanonicalInteriorDiskSides
  exterior_complement_subset :
    (∀ i, Disjoint Q.carrier (Q.disk i \ Q.boundary i)) →
      Q.diskComplement ⊆ Q.carrier
  winding_generated_by_boundary :
    ∀ L : TransportedWindingLoop Phi Q.carrier,
      ∃ a : Fin 3 → ℤ,
        L.windingPair = ∑ i, a i • (Q.circle i).windingLoop.windingPair

namespace ThreeBoundaryPairOfPantsTopology

variable {Q : ThreeBoundaryPairOfPantsCarrier Phi}

/-- Boundary generation and zero boundary winding force every loop in the pair of pants to have
zero winding. -/
theorem windingPair_eq_zero
    (T : ThreeBoundaryPairOfPantsTopology Q)
    (L : TransportedWindingLoop Phi Q.carrier) :
    L.windingPair = (0, 0) := by
  obtain ⟨a, ha⟩ := T.winding_generated_by_boundary L
  rw [ha]
  apply Prod.ext <;> simp [Q.zeroWinding]

/-- A three-boundary planar carrier with zero-winding boundary cannot itself carry torus genus. -/
theorem not_carriesBasedLoopTorusGenus
    (T : ThreeBoundaryPairOfPantsTopology Q) :
    ¬ CarriesBasedLoopTorusGenus Phi Q.carrier := by
  rintro ⟨W⟩
  have hfirst := T.windingPair_eq_zero W.first
  have hsecond := T.windingPair_eq_zero W.second
  apply W.independent
  simp [hfirst, hsecond, windingDet]

/-- One of the three canonical disks is the outer disk and contains the whole pair of pants. -/
theorem exists_canonicalDisk_contains_carrier
    (T : ThreeBoundaryPairOfPantsTopology Q) :
    ∃ i, Q.carrier ⊆ Q.disk i := by
  have hsides :=
    Q.hasCanonicalDiskSides_of_interiorDiskSides T.canonicalInteriorDiskSides
  rcases Q.exists_disk_contains_or_pairwise_disjoint_exterior hsides with
      hcontains | ⟨hdisjoint, hexterior⟩
  · exact hcontains
  · exfalso
    let D := Classical.choice <|
      EmbeddedTorusIntersectionCircle.exists_separatedZeroWindingDiskSupports_of_pairwise_disjoint
        Q.circle Q.zeroWinding hdisjoint
    have hcomplement : CarriesBasedLoopTorusGenus Phi Q.diskComplement := by
      exact carriesBasedLoopTorusGenus_of_finitePuncturePushout
        D.toFinitePuncturePushoutData
    exact T.not_carriesBasedLoopTorusGenus <|
      hcomplement.mono (T.exterior_complement_subset hexterior)

end ThreeBoundaryPairOfPantsTopology

end Submission.Topology
