      D.boundaryHomeomorph x
  apply_outer : ∀ x : Q.carrier,
    (E
      ⟨x, outerCarrier_subset_closedShell P Q hPQ x.2⟩ : Plane) =
      c x

def CompatibleClosedDiskHomeomorph.extendAcrossShellAgreements
    {P Q R S : PolygonalCircle} (D : CompatibleClosedDiskHomeomorph P R)
    (hPQ : P.closedRegion ⊆ Q.interiorRegion)
    (hRS : R.closedRegion ⊆ S.interiorRegion)
    (E : closedShell P Q ≃ₜ closedShell R S)
    (c : Q.carrier ≃ₜ S.carrier)
    (agreements : CompatibleShellAgreements P Q R S D hPQ E c) :
    CompatibleClosedDiskHomeomorph Q S :=
  D.extendAcrossShell hPQ hRS E c agreements.apply_inner agreements.apply_outer

