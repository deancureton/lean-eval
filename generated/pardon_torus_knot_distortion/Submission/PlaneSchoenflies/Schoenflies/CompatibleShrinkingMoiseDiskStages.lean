  exact @RecursiveInsideCollarStep.Later.dampedCompatibleMarkedMoiseBandHomeomorph_proof_irrel
    J I (I.shrinkingCompatibleBandParentStage n).level
    (I.shrinkingCompatibleBandParentStage n).epsilon
    (I.shrinkingCompatibleBandParentStage n).family
    (I.shrinkingCompatibleBandParentStage n).one_le_level
    (I.shrinkingCompatibleBand n) n (I.shrinkingCompatibleBand_outward n)
    b h₁ h₂ x

theorem shrinkingCompatibleBandHomeomorph_apply (n : ℕ)
    (b : (I.shrinkingCompatibleStageSourceDisk n).carrier ≃ₜ
      (I.shrinkingCompatibleStageTargetDisk n).carrier)
    (hshort : ∀ u,
      angularBoundaryCorrection n
          ((I.shrinkingCompatibleRawInnerBoundaryHomeomorph n).symm.trans b) u ≠
